generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
  CHAT
}

enum OAStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
}

enum ChannelProvider {
  ZALO
  TELEGRAM
  FACEBOOK
}

enum CustomerStatus {
  NEW
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELED
}

enum ConversationStatus {
  UNREAD
  PROCESSING
  RESOLVED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  TEMPLATE
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  FAILED
}

enum DealStage {
  NEW
  CONSULTING
  POTENTIAL
  WON
  LOST
}

enum TaskStatus {
  TODO
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  avatar             String?
  role               Role     @default(AGENT)
  isActive           Boolean  @default(true)
  isAcceptingChats   Boolean  @default(true)
  maxConcurrentChats Int      @default(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignedCustomers Customer[]        @relation("CustomerAssignee")
  conversations     Conversation[]    @relation("ConversationAssignee")
  sentMessages      Message[]         @relation("MessageSender")
  tasks             Task[]            @relation("TaskAssignee")
  notes             Note[]            @relation("NoteAuthor")
  appointments      Appointment[]     @relation("AppointmentStaff")
  deals             Deal[]            @relation("DealOwner")
  templates         MessageTemplate[] @relation("TemplateCreatedBy")
  oaAccess          OAStaffAccess[]
  activityLogs      ActivityLog[]     @relation("ActivityActor")
  notifications     Notification[]

  @@index([role])
}

model ZaloOA {
  id                String          @id @default(cuid())
  name              String
  avatar            String?
  zaloOaId          String          @unique
  status            OAStatus        @default(DISCONNECTED)
  lastSyncAt        DateTime?
  dailyMessageLimit Int             @default(500)
  messagesSentToday Int             @default(0)
  webhookSecret     String?
  webhookVerifiedAt DateTime?
  provider          ChannelProvider @default(ZALO)
  externalId        String?
  accessToken       String?         @db.Text
  appSecret         String?         @db.Text
  botUsername       String?
  createdAt         DateTime        @default(now())

  conversations Conversation[]
  staffAccess   OAStaffAccess[]

  @@index([provider])
}

model PersonalZaloAccount {
  id        String   @id @default(cuid())
  name      String
  proxyUrl  String?  @db.VarChar(2048)
  status    String   @default("disconnected")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerSource {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model TemplateCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model OAStaffAccess {
  id       String  @id @default(cuid())
  userId   String
  zaloOAId String
  canSend  Boolean @default(true)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  zaloOA ZaloOA @relation(fields: [zaloOAId], references: [id], onDelete: Cascade)

  @@unique([userId, zaloOAId])
}

model Customer {
  id           String         @id @default(cuid())
  name         String
  phone        String?        @unique
  zaloUserId   String?        @unique
  avatar       String?
  source       String         @default("Zalo OA")
  status       CustomerStatus @default(NEW)
  assignedToId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  assignedTo    User?          @relation("CustomerAssignee", fields: [assignedToId], references: [id])
  tags          CustomerTag[]
  notes         Note[]
  appointments  Appointment[]
  conversations Conversation[]
  deals         Deal[]
  tasks         Task[]
  activityLogs  ActivityLog[]

  @@index([assignedToId])
  @@index([status])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#0068FF")

  customers CustomerTag[]
}

model CustomerTag {
  customerId String
  tagId      String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

model Note {
  id         String   @id @default(cuid())
  customerId String
  authorId   String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([customerId])
}

model Appointment {
  id         String            @id @default(cuid())
  customerId String
  staffId    String
  title      String
  startAt    DateTime
  status     AppointmentStatus @default(SCHEDULED)
  createdAt  DateTime          @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    User     @relation("AppointmentStaff", fields: [staffId], references: [id])

  @@index([customerId])
  @@index([staffId])
  @@index([startAt])
}

model Conversation {
  id            String             @id @default(cuid())
  customerId    String
  zaloOAId      String
  assignedToId  String?
  isPinned      Boolean            @default(false)
  status        ConversationStatus @default(UNREAD)
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zaloOA        ZaloOA         @relation(fields: [zaloOAId], references: [id])
  assignedTo    User?          @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  messages      Message[]
  notifications Notification[]

  @@unique([customerId, zaloOAId])
  @@index([status])
  @@index([assignedToId])
  @@index([lastMessageAt])
}

model Message {
  id                   String           @id @default(cuid())
  conversationId       String
  direction            MessageDirection
  type                 MessageType      @default(TEXT)
  content              String           @db.Text
  attachmentUrl        String?
  externalSenderId     String?
  externalSenderName   String?
  externalSenderAvatar String?          @db.Text
  senderId             String?
  status               MessageStatus    @default(SENT)
  sentAt               DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([sentAt])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  title          String
  content        String   @db.Text
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([conversationId])
}

model MessageTemplate {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  category    String   @default("Chung")
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation("TemplateCreatedBy", fields: [createdById], references: [id])
}

model Deal {
  id         String    @id @default(cuid())
  customerId String
  stage      DealStage @default(NEW)
  value      Int       @default(0)
  ownerId    String
  note       String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner    User     @relation("DealOwner", fields: [ownerId], references: [id])

  @@index([stage])
  @@index([ownerId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  customerId  String?
  assigneeId  String
  dueAt       DateTime
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  createdAt   DateTime     @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  assignee User      @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([assigneeId])
  @@index([status])
  @@index([dueAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  customerId String
  actorId    String?
  type       String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actor    User?    @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([customerId])
  @@index([createdAt])
}
